	respond @untrusted 403
	reverse_proxy app:8080 {
		header_up X-Forwarded-For {http.request.header.EO-Connecting-IP}
		header_up -X-Real-IP
		header_up -EO-Connecting-IP
	}
}

# Approved customer-owned root domains and subdomains receive free public
# certificates on demand. Caddy preserves the original Host header so the app
# can resolve the correct reseller tenant.
https:// {
	tls {
		on_demand
	}
	reverse_proxy app:8080 {
		header_up X-Forwarded-For {http.request.remote.host}
		header_up -X-Real-IP
		header_up -EO-Connecting-IP
	}
}

http:// {
	redir https://{host}{uri} 308
}
